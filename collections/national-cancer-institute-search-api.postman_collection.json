  "info": {
    "_postman_id": "bdeab6b9-695f-4710-bab5-3a918c8fe3d0",
    "name": "NCI Genomic Data Commons (GDC) Download Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The GDC API provides programmatic access to cancer genomic and clinical data hosted by the National Cancer Institute Genomic Data Commons. The API supports search and retrieval of projects, cases, files, and annotations, along with file download, BAM slicing, and data submission workflows.\n\nContact Support:\n Name: NCI Genomic Data Commons",
      "type": "text/plain"
    }
  }
